@model IEnumerable<Announcement>

<style>
    .page-heading {
        font-weight: 800;
        font-size: 28px;
        color: #111827;
        letter-spacing: -0.5px;
        margin-bottom: 18px;
    }

    .btn-brand {
        background-color: #6366f1;
        border: none;
        color: #fff;
        border-radius: 30px;
        padding: 9px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
    }

        .btn-brand:hover {
            background-color: #4f46e5;
            color: #fff;
        }

    .btn-soft {
        border-radius: 30px;
        padding: 5px 14px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        text-decoration: none;
        display: inline-block;
    }

    .btn-soft-edit {
        background: #eef0ff;
        color: #6366f1;
    }

        .btn-soft-edit:hover {
            background: #6366f1;
            color: #fff;
        }

    .btn-soft-delete {
        background: #fef2f2;
        color: #ef4444;
    }

        .btn-soft-delete:hover {
            background: #ef4444;
            color: #fff;
        }

    .alert-success-soft {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #047857;
        border-radius: 12px;
        padding: 12px 18px;
        font-weight: 500;
        font-size: 14.5px;
        margin-bottom: 20px;
    }

    .table-card {
        background: #ffffff;
        border: 1px solid #eef0f4;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        overflow: hidden;
    }

    .announcement-table {
        margin-bottom: 0;
    }

        .announcement-table thead th {
            background: #f9fafb;
            color: #6b7280;
            font-size: 12.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 1px solid #eef0f4;
            padding: 14px 16px;
            border-top: none;
        }

        .announcement-table tbody td {
            vertical-align: middle;
            padding: 12px 16px;
            font-size: 14.5px;
            color: #374151;
            border-bottom: 1px solid #f3f4f6;
            border-top: none;
        }

        .announcement-table tbody tr:hover {
            background: #fafaff;
        }

        .announcement-table tbody tr:last-child td {
            border-bottom: none;
        }

    .announcement-title-cell {
        font-weight: 600;
        color: #111827;
    }

    .status-badge {
        font-weight: 600;
        font-size: 12.5px;
        padding: 4px 12px;
        border-radius: 20px;
    }

    .status-active {
        background: #ecfdf5;
        color: #059669;
    }

    .status-inactive {
        background: #f3f4f6;
        color: #6b7280;
    }
</style>

<h2 class="page-heading">Manage Announcements</h2>

<a asp-action="Create" class="btn btn-brand mb-4">+ New Announcement</a>

@if (TempData["Success"] != null)
{
    <div class="alert-success-soft">✓ @TempData["Success"]</div>
}

<div class="table-card">
    <table class="table announcement-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Created Date</th>
                <th>Active</th>
                <th>Expiry Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="announcement-title-cell">@item.Title</td>
                    <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="status-badge status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Inactive</span>
                        }
                    </td>
                    <td>@(item.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.AnnouncementId" class="btn-soft btn-soft-edit">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.AnnouncementId" class="btn-soft btn-soft-delete">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>