@model TeamPortal.NET.Models.ViewModel.RegisterVM

<style>
    body {
        background-color: #f5f5f7;
    }

    .auth-wrapper {
        min-height: 90vh;
        position: relative;
        overflow: hidden;
    }

        .auth-wrapper::before {
            content: "";
            position: absolute;
            top: -100px;
            left: -100px;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(99,102,241,0.25), transparent 70%);
            border-radius: 50%;
            filter: blur(20px);
            z-index: 0;
        }

        .auth-wrapper::after {
            content: "";
            position: absolute;
            bottom: -120px;
            right: -100px;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(34,197,180,0.20), transparent 70%);
            border-radius: 50%;
            filter: blur(20px);
            z-index: 0;
        }

    .auth-card {
        position: relative;
        z-index: 1;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        border: none;
    }

        .auth-card .form-control {
            border-radius: 12px;
            padding: 10px 14px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
        }

            .auth-card .form-control:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
                background: #fff;
            }

    .btn-brand {
        background-color: #6366f1;
        border: none;
        border-radius: 30px;
        padding: 10px;
        font-weight: 600;
        color: #fff;
    }

        .btn-brand:hover {
            background-color: #4f46e5;
            color: #fff;
        }

    .auth-card a {
        color: #6366f1;
        font-weight: 600;
        text-decoration: none;
    }

        .auth-card a:hover {
            text-decoration: underline;
        }
</style>

<div class="auth-wrapper d-flex align-items-center justify-content-center py-5">
    <div class="card auth-card p-4 p-md-5" style="max-width: 420px; width: 100%;">
        <h2 class="fw-bold mb-1">Create Account</h2>
        <p class="text-muted mb-4">Sign up to get started with Team Portal.</p>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="Register" method="post">
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label fw-semibold small"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label fw-semibold small"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="control-label fw-semibold small"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-brand w-100">Register</button>
            </div>

            <p class="text-center text-muted mt-4 mb-0">
                Already have an account? <a asp-action="Login">Login here</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}