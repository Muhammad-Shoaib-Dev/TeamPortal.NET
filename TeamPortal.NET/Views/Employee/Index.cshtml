@model TeamPortal.NET.Models.ViewModel.PaginatedListVM<Employee>

<style>
    .page-heading {
        font-weight: 800;
        font-size: 28px;
        color: #111827;
        letter-spacing: -0.5px;
        margin-bottom: 18px;
    }

    .btn-brand {
        background-color: #6366f1;
        border: none;
        color: #fff;
        border-radius: 30px;
        padding: 9px 22px;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
    }

        .btn-brand:hover {
            background-color: #4f46e5;
            color: #fff;
        }

    .btn-outline-brand {
        border: 1px solid #6366f1;
        color: #6366f1;
        border-radius: 30px;
        padding: 8px 20px;
        font-weight: 600;
        font-size: 14px;
        background: transparent;
        transition: 0.2s;
    }

        .btn-outline-brand:hover {
            background-color: #6366f1;
            color: #fff;
        }

        .btn-outline-brand.disabled {
            opacity: 0.4;
            pointer-events: none;
        }

    .btn-soft {
        border-radius: 30px;
        padding: 6px 14px;
        font-size: 12.5px;
        font-weight: 600;
        border: none;
        text-decoration: none;
        display: inline-block;
    }

    .btn-soft-edit {
        background: #eef0ff;
        color: #6366f1;
    }

        .btn-soft-edit:hover {
            background: #6366f1;
            color: #fff;
        }

    .btn-soft-delete {
        background: #fef2f2;
        color: #ef4444;
    }

        .btn-soft-delete:hover {
            background: #ef4444;
            color: #fff;
        }

    /* ===== Filter Card ===== */
    .filter-card {
        background: #ffffff;
        border: 1px solid #eef0f4;
        border-radius: 16px;
        padding: 20px 22px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        margin-bottom: 26px;
    }

        .filter-card .form-label {
            font-size: 12.5px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 4px;
        }

        .filter-card .form-control,
        .filter-card select.form-control {
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            background: #f9fafb;
            font-size: 14px;
            padding: 8px 10px;
        }

            .filter-card .form-control:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
                background: #fff;
            }

    .sort-bar {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
        font-size: 13px;
    }

        .sort-bar a {
            color: #6b7280;
            text-decoration: none;
            font-weight: 600;
        }

            .sort-bar a:hover {
                color: #6366f1;
            }

    /* ===== Employee Card Grid ===== */
    .employee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 20px;
        margin-bottom: 26px;
    }

    .employee-card {
        background: #ffffff;
        border: 1px solid #eef0f4;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        transition: 0.2s;
        text-align: center;
    }

        .employee-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 26px rgba(0,0,0,0.08);
        }

    .employee-photo-wrap {
        background: #f3f4f6;
        padding: 24px 0 12px;
    }

    .employee-avatar {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #ffffff;
        box-shadow: 0 0 0 3px #eef0ff;
    }

    .employee-body {
        padding: 14px 16px 18px;
    }

    .employee-card-name {
        font-weight: 700;
        font-size: 16px;
        color: #111827;
        margin-bottom: 2px;
    }

    .employee-card-designation {
        color: #6366f1;
        font-size: 12.5px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .employee-card-meta {
        font-size: 12.5px;
        color: #6b7280;
        margin-bottom: 3px;
    }

    .employee-card-dept-badge {
        display: inline-block;
        background: #f3f4f6;
        color: #374151;
        font-size: 11.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        margin: 8px 0 12px;
    }

    .employee-card-actions {
        display: flex;
        justify-content: center;
        gap: 8px;
        border-top: 1px solid #f3f4f6;
        padding-top: 12px;
    }

    /* ===== Pagination ===== */
    .pagination-bar {
        background: #ffffff;
        border: 1px solid #eef0f4;
        border-radius: 14px;
        padding: 12px 20px;
        margin-top: 20px;
        font-size: 14px;
        color: #6b7280;
        font-weight: 500;
    }
</style>

<h2 class="page-heading">Employees</h2>
@if (User.IsInRole("Admin"))
{
<a asp-controller="Employee" asp-action="Create" class="btn btn-brand mb-4">+ Create Employee</a>
}

<div class="filter-card">
    <form asp-action="Index" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Search</label>
                <input type="text" name="Search"
                       value="@ViewData["CurrentFilter"]"
                       placeholder="Search by name, email..."
                       class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Department</label>
                <select name="Department" asp-items="@((SelectList)ViewData["Departments"])" class="form-control">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Designation</label>
                <select name="Designation" asp-items="@((SelectList)ViewData["Designations"])" class="form-control">
                    <option value="">All Designations</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="isActive" class="form-control">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(ViewData["isActive"]?.ToString() == "True")">Active</option>
                    <option value="false" selected="@(ViewData["isActive"]?.ToString() == "False")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Min Salary</label>
                <input type="number" name="minSalary" value="@ViewData["minSalary"]" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Max Salary</label>
                <input type="number" name="maxSalary" value="@ViewData["maxSalary"]" class="form-control" />
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-brand">Apply Filters</button>
            <a asp-action="Index" class="btn btn-outline-brand">Clear</a>
        </div>
    </form>
</div>

<!-- Sort links (table headers ki jagah, kyunki ab table nahi hai) -->
<div class="sort-bar">
    <span style="color:#9ca3af;">Sort by:</span>
    <a asp-action="Index" asp-route-Sort="@ViewData["NameSortparam"]">Name</a>
    <a asp-action="Index" asp-route-Sort="@ViewData["EmailSortparam"]">Email</a>
    <a asp-action="Index" asp-route-Sort="@ViewData["DesignationSortparam"]">Designation</a>
    <a asp-action="Index" asp-route-Sort="@ViewData["DepartmentIDSortparam"]">Department</a>
</div>

<div class="employee-grid">
    @foreach (var employee in Model)
    {
        <div class="employee-card">
            <div class="employee-photo-wrap">
                <img src="@employee.ProfilePicture" class="employee-avatar" />
            </div>
            <div class="employee-body">
                <div class="employee-card-name">@employee.FirstName @employee.LastName</div>
                <div class="employee-card-designation">@employee.Designation</div>

                <span class="employee-card-dept-badge">@employee.Department?.DepartmentName</span>

                <div class="employee-card-meta">@employee.Email</div>
                <div class="employee-card-meta">Dept ID: @employee.DepartmentId</div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="employee-card-actions">
                        <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn-soft btn-soft-edit">Edit</a>
                        <a asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.EmployeeId" class="btn-soft btn-soft-delete">Delete</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<div class="pagination-bar d-flex justify-content-between align-items-center">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       asp-route-Search="@ViewData["CurrentFilter"]"
       asp-route-Sort="@Context.Request.Query["Sort"]"
       asp-route-Department="@Context.Request.Query["Department"]"
       asp-route-Designation="@Context.Request.Query["Designation"]"
       asp-route-isActive="@Context.Request.Query["isActive"]"
       asp-route-minSalary="@Context.Request.Query["minSalary"]"
       asp-route-maxSalary="@Context.Request.Query["maxSalary"]"
       class="btn btn-outline-brand @prevDisabled">
        ← Previous
    </a>

    <span>Page @Model.PageIndex of @Model.TotalPage</span>

    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       asp-route-Search="@ViewData["CurrentFilter"]"
       asp-route-Sort="@Context.Request.Query["Sort"]"
       asp-route-Department="@Context.Request.Query["Department"]"
       asp-route-Designation="@Context.Request.Query["Designation"]"
       asp-route-isActive="@Context.Request.Query["isActive"]"
       asp-route-minSalary="@Context.Request.Query["minSalary"]"
       asp-route-maxSalary="@Context.Request.Query["maxSalary"]"
       class="btn btn-outline-brand @nextDisabled">
        Next →
    </a>
</div>