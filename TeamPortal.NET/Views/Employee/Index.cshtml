@model IEnumerable<TeamPortal.NET.Models.Employee>

<h2>Employees</h2>

<table class="table">
            <a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create Employee</a>
    <thead>
        <tr>
            <form asp-action="Index" method="get">
                <input type="text" name="Search"
                       value="@ViewData["CurrentFilter"]"
                       placeholder="Search by name, email, department..."
                       class="form-control" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </tr>
        <tr>
            <th>Profile photo </th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td><img src="@employee.ProfilePicture" width="60" height="60" /></td>
                <td>@employee.FirstName</td>
                <td>@employee.LastName</td>
                <td>@employee.Email</td>
                <td>@employee.DepartmentId</td>
                <td>
                    <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-secondary">Edit</a>
                    <a asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.EmployeeId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>