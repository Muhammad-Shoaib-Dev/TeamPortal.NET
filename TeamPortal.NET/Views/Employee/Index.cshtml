@model TeamPortal.NET.Models.ViewModel.PaginatedListVM<Employee>

<h2>Employees</h2>

<a asp-controller="Employee" asp-action="Create" class="btn btn-primary mb-3">Create Employee</a>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Search</label>
            <input type="text" name="Search"
                   value="@ViewData["CurrentFilter"]"
                   placeholder="Search by name, email..."
                   class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Department</label>
            <select name="Department" asp-items="@((SelectList)ViewData["Departments"])" class="form-control">
                <option value="">All Departments</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Designation</label>
            <select name="Designation" asp-items="@((SelectList)ViewData["Designations"])" class="form-control">
                <option value="">All Designations</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select name="isActive" class="form-control">
                <option value="">All Statuses</option>
                <option value="true" selected="@(ViewData["isActive"]?.ToString() == "True")">Active</option>
                <option value="false" selected="@(ViewData["isActive"]?.ToString() == "False")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Min Salary</label>
            <input type="number" name="minSalary" value="@ViewData["minSalary"]" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Max Salary</label>
            <input type="number" name="maxSalary" value="@ViewData["maxSalary"]" class="form-control" />
        </div>
        <div class="col-md-2 mt-2">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Profile photo</th>
            <th><a asp-action="Index" asp-route-Sort="@ViewData["NameSortparam"]">Name</a></th>
            <th><a asp-action="Index" asp-route-Sort="@ViewData["EmailSortparam"]">Email</a></th>
            <th>Department ID</th>
            <th><a asp-action="Index" asp-route-Sort="@ViewData["DesignationSortparam"]">Designation</a></th>
            <th><a asp-action="Index" asp-route-Sort="@ViewData["DepartmentIDSortparam"]">Department</a></th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td><img src="@employee.ProfilePicture" width="60" height="60" /></td>
                <td>@employee.FirstName @employee.LastName</td>
                <td>@employee.Email</td>
                <td>@employee.DepartmentId</td>
                <td>@employee.Designation</td>
                <td>@employee.Department?.DepartmentName</td>
                <td>
                    <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-secondary">Edit</a>
                    <a asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.EmployeeId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
        
    </tbody>
</table>
@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       asp-route-Search="@ViewData["CurrentFilter"]"
       asp-route-Sort="@Context.Request.Query["Sort"]"
       asp-route-Department="@Context.Request.Query["Department"]"
       asp-route-Designation="@Context.Request.Query["Designation"]"
       asp-route-isActive="@Context.Request.Query["isActive"]"
       asp-route-minSalary="@Context.Request.Query["minSalary"]"
       asp-route-maxSalary="@Context.Request.Query["maxSalary"]"
       class="btn btn-outline-primary @prevDisabled">
        Previous
    </a>

    <span>Page @Model.PageIndex of @Model.TotalPage</span>

    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       asp-route-Search="@ViewData["CurrentFilter"]"
       asp-route-Sort="@Context.Request.Query["Sort"]"
       asp-route-Department="@Context.Request.Query["Department"]"
       asp-route-Designation="@Context.Request.Query["Designation"]"
       asp-route-isActive="@Context.Request.Query["isActive"]"
       asp-route-minSalary="@Context.Request.Query["minSalary"]"
       asp-route-maxSalary="@Context.Request.Query["maxSalary"]"
       class="btn btn-outline-primary @nextDisabled">
        Next
    </a>
</div>